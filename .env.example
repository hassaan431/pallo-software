# ==============================================================================
# Pallo Multi-Tenant SaaS — Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon.tech)
# ------------------------------------------------------------------------------
# Get your connection string from the Neon dashboard (Direct or Pooled URL):
# Format: postgresql://<username>:<password>@<endpoint-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection Pool sizing for psycopg2 ThreadedConnectionPool
DB_POOL_MIN=2
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 2. Flask Application Security & Mode
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-to-a-cryptographically-secure-random-key
FLASK_ENV=production

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (Branding & Logo Persistence)
# ------------------------------------------------------------------------------
# Leave empty for local filesystem storage fallback (static/logos/companies/)
# Or obtain these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: custom domain (e.g. https://media.pallo.app) or R2 dev subdomain
R2_PUBLIC_URL=
