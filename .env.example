# ========================================================
# Pallo Multi-Tenant SaaS - Environment Configuration
# ========================================================

# PostgreSQL Database Connection URL (Required for PostgreSQL SaaS Mode)
#
# Formats:
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pallo_db
#
# Neon Serverless PostgreSQL (Recommended free tier):
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
#
# Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
#
# PythonAnywhere PostgreSQL:
# DATABASE_URL=postgresql://[username]:[password]@[username]-xxxx.postgres.pythonanywhere-services.com:5432/[dbname]
#
DATABASE_URL=

# Connection Pool Settings
DB_POOL_MIN=1
DB_POOL_MAX=20

# Flask App Secret Key
SECRET_KEY=dev-secret-key-change-in-production
